# Local synthetic demo defaults.
# Copy to .env.local only for local development.
#
# Do not put real PHI, production EHR URLs, payer endpoints, API keys,
# payer credentials, access tokens, or customer-specific secrets in this file.

# Browser-facing API base URL used by apps/web.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Documentation-only reference for the local API port.
OPEN_PRIOR_AUTH_API_PORT=4000

# Optional local SQLite database path for apps/api.
OPEN_PRIOR_AUTH_DB_PATH=.data/open-prior-auth.sqlite

# Optional local evidence upload directory for synthetic demo files.
OPEN_PRIOR_AUTH_EVIDENCE_UPLOAD_DIR=.data/evidence-uploads
